{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/reject-long-comments.mjs\"",
            "timeout": 60,
            "statusMessage": "Checking comments with static-x..."
          }
        ]
      }
    ]
  }
}
